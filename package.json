{
  "name": "mapper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "mapper contributors",
  "description": "Desktop map management for original fictional worlds",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:large-image": "vitest run tests/large-image.test.ts --config vitest.large.config.ts",
    "release:linux": "pnpm build && node scripts/collect-notices.mjs && electron-builder --linux --x64 --publish never",
    "release:win": "pnpm build && node scripts/collect-notices.mjs && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "bezier-js": "^6.1.4",
    "clipper-lib": "^6.4.2",
    "konva": "^10.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.3.0",
    "sharp": "^0.34.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bezier-js": "^4.1.3",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.17.0",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  }
}
